{
  "schemaVersion": "1.0",
  "name": "seekfleet",
  "displayName": "SeekFleet",
  "description": "Cross-platform control plane for DeepSeek Harness (dsh) agent fleets. Exposes one-shot tasks, durable sessions, routed clusters, dependency DAGs, budgets and policies over MCP stdio for Claude, Codex, Cursor, Gemini, Hermes and OpenClaw style clients.",
  "version": "0.1.1",
  "homepage": "https://github.com/cndoin/seekfleet",
  "license": "MIT",
  "transport": {
    "type": "stdio",
    "command": "node",
    "args": [
      "dist/bin/seekfleet.js",
      "serve-mcp"
    ]
  },
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "tools": [
    {
      "name": "dsh_inspect",
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "dsh_run",
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
